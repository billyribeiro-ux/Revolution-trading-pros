{
	"name": "svelte-click-to-source",
	"version": "0.1.1",
	"description": "Alt+Click any element in dev mode to open its source in your editor",
	"keywords": [
		"click-to-source",
		"developer-tools",
		"svelte",
		"sveltekit",
		"vite"
	],
	"license": "MIT",
	"author": "Welber Ribeiro",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test",
		"check": "tsc --noEmit",
		"dev": "vp pack --watch",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"magic-string": "^1.4.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^4.0.0 || ^5.0.0",
		"vite": "^5.0.0 || ^6.0.0 || ^8.0.0"
	}
}
