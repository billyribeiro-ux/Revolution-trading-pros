{
	"name": "@revolution/behavior-tracker",
	"version": "0.1.0",
	"private": false,
	"license": "UNLICENSED",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tracker": {
			"types": "./dist/tracker.d.ts",
			"default": "./dist/tracker.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "pnpm build && node --test test/*.test.mjs",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=20.9.0"
	}
}
