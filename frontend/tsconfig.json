{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "vite.config.ts"],
	// src/service-worker is its own project (webworker lib, not DOM) — see
	// src/service-worker/tsconfig.json.
	"exclude": ["node_modules", ".svelte-kit", "build", "src/service-worker"]
}
