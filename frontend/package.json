{
	"name": "revolution-svelte",
	"version": "2.0.0",
	"description": "A SvelteKit project for Revolution.",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"engines": {
		"node": ">=26.13.0",
		"pnpm": ">=12.16.1"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:fast": "vite dev",
		"build": "vite build",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
		"build:static": "DEPLOY_TARGET=static vite build",
		"preview": "vite preview",
		"preview:component": "node scripts/preview-component.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:all": "NODE_OPTIONS='--max-old-space-size=4096' svelte-check",
		"check:types": "tsc --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:strict": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:a11y": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --compiler-warnings 'a11y_missing_attribute:error,a11y_label_has_associated_control:error,a11y_click_events_have_key_events:error,a11y_no_static_element_interactions:error,a11y_no_noninteractive_element_interactions:error'",
		"lint": "NODE_OPTIONS='--max-old-space-size=4096' eslint .",
		"lint:fix": "NODE_OPTIONS='--max-old-space-size=4096' eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:unit:ui": "vitest --ui",
		"test:unit:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:a11y": "playwright test tests/accessibility --project=chromium",
		"test:sanitizer:browser": "node scripts/sanitizer-differential.js",
		"test:ci": "pnpm run test:unit",
		"analyze": "vite-bundle-visualizer",
		"deploy:cloudflare": "pnpm run build:cloudflare && wrangler pages deploy .svelte-kit/cloudflare",
		"deploy:preview": "pnpm run build:cloudflare && wrangler pages deploy .svelte-kit/cloudflare --branch preview",
		"ports:check": "lsof -i:5173 -i:5174 -i:8080 -i:5432 -i:6379 || echo 'No processes found on those ports'",
		"dev:clean": "lsof -ti:5173 | xargs kill -9 2>/dev/null; lsof -ti:5174 | xargs kill -9 2>/dev/null; pnpm dev",
		"dev:fresh": "docker compose down && docker compose up -d && pnpm dev:clean"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@stripe/stripe-js": "^10.2.0",
		"@tabler/icons-svelte-runes": "^3.50.0",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.4",
		"@vimeo/player": "^2.30.4",
		"blurhash": "^2.0.5",
		"canvas-confetti": "^1.9.4",
		"d3": "^7.9.0",
		"diff-match-patch": "^1.0.5",
		"embla-carousel": "^8.6.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"gsap": "^3.15.0",
		"hast-util-from-dom": "^5.0.1",
		"hast-util-from-parse5": "^8.0.3",
		"hast-util-sanitize": "^5.0.2",
		"hast-util-to-html": "^9.0.5",
		"html2canvas": "^1.4.1",
		"lightweight-charts": "^5.2.1",
		"parse5": "^8.0.1",
		"property-information": "^7.2.0",
		"schema-dts": "2.1.0",
		"svelte-meta-tags": "5.0.3",
		"three": "^0.186.1",
		"tus-js-client": "^4.3.1",
		"typed.js": "^3.0.0",
		"valibot": "^1.5.0",
		"web-vitals": "^6.2.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@paypal/paypal-js": "^11.3.0",
		"@playwright/test": "^1.64.1",
		"@square/web-payments-sdk-types": "^1.87.2",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/d3": "^7.4.3",
		"@types/d3-array": "^3.2.2",
		"@types/d3-axis": "^3.0.6",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-shape": "^3.2.0",
		"@types/diff-match-patch": "^1.0.36",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.6.6",
		"@types/three": "^0.186.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"d3-array": "^3.2.4",
		"d3-axis": "^3.0.0",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"magic-string": "^1.4.5",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-inspect-value": "^0.11.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-bundle-visualizer": "^1.2.1",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	},
	"imports": {
		"#lib/utils/html-sanitizer/parse-fragment.js": {
			"browser": "./src/lib/utils/html-sanitizer/parse-fragment.browser.js",
			"default": "./src/lib/utils/html-sanitizer/parse-fragment.server.js"
		},
		"#lib/*": "./src/lib/*"
	}
}
